# ==============================================================
# PlantCare Frontend Environment Variables (.env)
# Copy this file to frontend/.env and replace with your real keys
# ==============================================================

# 1. Clerk Publishable Key (Must match the one in backend/.env)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# 2. FastAPI Backend URL (Defaults to http://localhost:8000 for local development)
VITE_API_URL=http://localhost:8000
