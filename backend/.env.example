# ==============================================================
# PlantCare Backend Environment Variables (.env)
# Copy this file to backend/.env and replace with your real keys
# ==============================================================

# 1. Database URL (Optional: Defaults to local SQLite if left empty or commented out)
# For production Neon PostgreSQL:
DATABASE_URL=postgresql://user:password@ep-your-database.aws.neon.tech/neondb?sslmode=require

# 2. Groq Cloud API Key (Required for AI Agri Doctor Chatbot)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. Clerk Authentication Keys (Required if using Clerk User Authentication)
# Get your keys at: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# 4. OpenWeatherMap API Key (Optional: For precise reverse-geocoded farm location name)
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
